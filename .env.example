# Copy to .env for local development. On Vercel, set these in Project Settings → Environment Variables.

# Long id after /d/e/ in any published-to-web CSV link of the Meloviziya sheet (starts with 2PACX-)
SHEET_PUB_ID=
# gid of the Parametrlər tab
GID_PARAMETRLER=
# gid of the Ölkələr tab
GID_OLKELER=
# gid of the İştirakçılar tab
GID_ISTIRAKCILAR=
# gid of the Reyestr tab
GID_REYESTR=
# gid of the Mövsüm tab
GID_MOVSUM=
# gid of the Cədvəl tab
GID_CEDVEL=
# gid of the Arxiv tab
GID_ARXIV=
# Invite link to the Meloviziya Telegram group, shown in the footer
NEXT_PUBLIC_TELEGRAM_URL=
# Spotify playlist of the current season (optional)
NEXT_PUBLIC_PLAYLIST_URL=
